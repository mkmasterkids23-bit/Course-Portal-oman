// Prisma schema for CourseLearn — Multi-University Learning Management Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String
  role          String   @default("STUDENT") // STUDENT | ADMIN | UNIVERSITY
  phone         String?
  bio           String?
  profilePhoto  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  university       University?
  subscriptions    Subscription[]
  videoProgress    VideoProgress[]
  submissions      AssignmentSubmission[]
  certificates     Certificate[]
  videoAssessments VideoAssessment[]
}

model University {
  id          String   @id @default(cuid())
  name        String
  logo        String?
  description String?
  userId      String   @unique  // links to the User account (login credentials)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courses     Course[]

  @@index([userId])
}

model SubscriptionPlan {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float
  currency    String   @default("OMR")
  duration    Int      @default(1)
  durationUnit String  @default("MONTHS") // DAYS | WEEKS | MONTHS | YEARS
  features    String   @default("[]") // JSON array of strings
  benefits    String   @default("[]") // JSON array of strings
  isActive    Boolean  @default(true)
  isPopular   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions  Subscription[]
  courseAccess   CoursePlanAccess[]
}

model Subscription {
  id             String   @id @default(cuid())
  studentId      String
  planId         String
  planName       String
  planPrice      Float
  planCurrency   String
  planDuration   Int
  planDurationUnit String
  startDate      DateTime @default(now())
  expiryDate     DateTime
  status         String   @default("ACTIVE") // ACTIVE | EXPIRED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  student        User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  plan           SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([studentId])
  @@index([status])
}

model Course {
  id            String   @id @default(cuid())
  title         String
  description   String?
  thumbnail     String?
  category      String?
  accessType    String   @default("FREE") // FREE | PAID
  isPublished   Boolean  @default(false)
  universityId  String?  // null = platform course (main admin), or university-owned
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  university       University? @relation(fields: [universityId], references: [id], onDelete: SetNull)
  topics         Topic[]
  videos         VideoLesson[]
  materials      LearningMaterial[]
  assignments    Assignment[]
  planAccess     CoursePlanAccess[]
  certificates   Certificate[]
  certificateTemplate CertificateTemplate?

  @@index([universityId])
}

model CoursePlanAccess {
  id        String @id @default(cuid())
  courseId  String
  planId    String

  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  plan      SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([courseId, planId])
}

model Topic {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  description String?
  displayOrder Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  videos     VideoLesson[]
  materials  LearningMaterial[]

  @@index([courseId])
}

model VideoLesson {
  id          String   @id @default(cuid())
  courseId    String
  topicId     String
  title       String
  description String?
  source      String   @default("UPLOAD") // UPLOAD | YOUTUBE | URL
  videoUrl    String
  thumbnail   String?
  displayOrder Int     @default(0)
  isPublished Boolean  @default(true)
  duration    Int      @default(0) // seconds, optional metadata
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  topic       Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  progress    VideoProgress[]
  questions   VideoQuestion[]
  assessments VideoAssessment[]

  @@index([courseId])
  @@index([topicId])
}

model LearningMaterial {
  id          String   @id @default(cuid())
  courseId    String
  topicId     String?
  title       String
  description String?
  type        String   @default("PDF") // PDF | DOC | PRESENTATION | LINK
  fileUrl     String
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  topic      Topic?   @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@index([courseId])
}

model VideoProgress {
  id                String    @id @default(cuid())
  studentId         String
  videoId           String
  lastPosition      Float     @default(0) // seconds
  watchTimeSeconds  Float     @default(0) // actual accumulated watch time
  duration          Float     @default(0) // known video duration
  isCompleted       Boolean   @default(false)
  completedAt       DateTime?
  updatedAt         DateTime  @updatedAt

  student           User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  video             VideoLesson @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([studentId, videoId])
  @@index([studentId])
}

model Assignment {
  id             String   @id @default(cuid())
  courseId       String
  title          String
  description    String?
  instructions   String?
  fileUrl        String?
  dueDate        DateTime?
  isPublished    Boolean  @default(true)
  allowResubmission Boolean @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  course         Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  submissions    AssignmentSubmission[]

  @@index([courseId])
}

model AssignmentSubmission {
  id             String   @id @default(cuid())
  assignmentId   String
  studentId      String
  fileUrl        String
  submittedAt    DateTime @default(now())
  status         String   @default("SUBMITTED") // SUBMITTED | REVIEWED
  reviewNotes    String?
  reviewedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  assignment     Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student        User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([studentId])
  @@index([assignmentId])
}

model CertificateTemplate {
  id              String   @id @default(cuid())
  courseId        String   @unique
  isEnabled       Boolean  @default(true)
  title           String   @default("Certificate of Completion")
  bodyText        String   @default("This certificate is proudly presented to {{studentName}} for successfully completing the course {{courseName}}.")
  organizationName String  @default("CourseLearn")
  layout          String   @default("CLASSIC")
  templateRef     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Certificate {
  id              String   @id @default(cuid())
  studentId       String
  courseId        String
  templateTitle   String
  templateText    String
  organizationName String
  certificateNumber String @unique
  issuedAt        DateTime @default(now())
  createdAt       DateTime @default(now())

  student         User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@index([studentId])
}

// ─── Video-Based Interactive Assessment ────────────────────────────────

model VideoQuestion {
  id            String   @id @default(cuid())
  videoId       String
  question      String
  options       String   @default("[]") // JSON array of answer option strings
  correctAnswer Int      @default(0) // index into options array
  timestamp     Float    @default(0) // seconds into the video when question appears
  displayOrder  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  video         VideoLesson @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId])
}

model VideoAssessment {
  id           String   @id @default(cuid())
  studentId    String
  videoId      String
  score        Int      @default(0) // percentage 0-100
  passed       Boolean  @default(false) // true if score >= 70
  answers      String   @default("[]") // JSON: [{questionId, selectedAnswer, correct}]
  attempts     Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student      User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  video        VideoLesson @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([studentId, videoId])
  @@index([studentId])
}
